{
  "bind_host": "127.0.0.1",
  "port": 8765,
  "allowed_hosts": [],
  "remote_approvals": false,
  "human_owner": "Rich",
  "watcher_name": "taskbench-local",
  "data_dir": "var",
  "projects_dir": "projects",
  "runners": {
    "grok-build": {
      "adapter": "grok_build",
      "executable": "grok",
      "args_template": [
        "--permission-mode",
        "dontAsk",
        "--sandbox",
        "strict",
        "--output-format",
        "streaming-messages-json",
        "--prompt-file",
        "{prompt_file}",
        "--cwd",
        "{project_dir}"
      ],
      "can_ask": false,
      "sandbox_only": false
    }
  }
}
